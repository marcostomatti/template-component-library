{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "React Library",
  "extends": "@open-tomato/typescript-config/react",
  "compilerOptions": {
    "types": ["node"],
    // Off: about 600 exports lack an explicit type, most of them inferred CVA
    // variant functions in the *.variants.ts files, plus components and story
    // objects. vite-plugin-dts emits the declarations from the full program,
    // so nothing needs per-file declarations today. Follow-up: annotate the
    // variants exports and turn it back on.
    "isolatedDeclarations": false
  },
  "include": ["src", "*.ts", "*.tsx", "*.mjs", ".storybook"],
  "exclude": ["node_modules", "dist", "storybook-static"]
}
